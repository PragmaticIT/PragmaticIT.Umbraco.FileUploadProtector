@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Web.Common.PublishedModels;
@inject IMemberManager _memberManager;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "layout.cshtml";
    ViewData["Title"] = Model.Name;
    var pages = Task.WhenAll(Model.DescendantsOfType("page").Select(async x =>
    {
        var isProtected = await _memberManager.IsProtectedAsync(x.Path);
        var memberHasAccess = await _memberManager.MemberHasAccessAsync(x.Path);
        return new PageInfo(x.Name, x.Url(), isProtected, memberHasAccess);
    })).GetAwaiter().GetResult();
    var documents = Model.Descendants().OfTypes("document").ToList();
}

@functions {
    private record PageInfo(string Name, string Url, bool IsProtected, bool MemberHasAccess);
}

<div class="container">

    <div class="mb-4">
        <h2 class="fw-semibold mb-0">@Model.Name</h2>
        <hr />
    </div>

    <div class="row g-4">

        <div class="col-12 col-lg-4">

            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-diagram-3 me-2 text-primary"></i>Sub-pages</h6>
                </div>
                <div class="card-body p-0">
                    @if (pages.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (PageInfo subPage in pages)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-2">
                                    <a href="@subPage.Url" class="text-decoration-none text-body fw-medium">
                                        <i class="bi bi-file-text me-1 text-secondary"></i>@subPage.Name
                                    </a>
                                    <span>
                                        @if (subPage.IsProtected)
                                        {
                                            @if (subPage.MemberHasAccess)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="bi bi-unlock-fill me-1"></i>Access
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                    <i class="bi bi-lock-fill me-1"></i>Protected
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="bi bi-globe me-1"></i>Public
                                            </span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-inbox fs-4 d-block mb-1"></i>No sub-pages found
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-paperclip me-2 text-primary"></i>Documents</h6>
                </div>
                <div class="card-body p-0">
                    @if (documents.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var doc in documents)
                            {
                                <li class="list-group-item px-3 py-2">
                                    <a href="@(doc.Value<string>("file"))" target="preview"
                                           class="text-decoration-none text-body">
                                        <i class="bi bi-file-earmark me-1 text-secondary"></i>@doc.Name
                                    </a>
                                </li>
                            }
                        </ul>
                        <p>Image resizer results</p>
                        <ul class="list-group list-group-flush">
                            @foreach (var doc in documents)
                            {
                                var fileUrl = doc.Value<string>("file");
                                var isImage = fileUrl != null && (fileUrl.EndsWith(".jpg") || fileUrl.EndsWith(".png"));
                                if (isImage)
                                {
                                    <li class="list-group-item px-3 py-2">
                                        <a href="@(fileUrl + "?width=50")" target="preview"
                                               class="text-decoration-none text-body">
                                            <i class="bi bi-file-earmark me-1 text-secondary"></i>@doc.Name
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                        
                    }
                    else
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-folder2-open fs-4 d-block mb-1"></i>No documents found
                        </div>
                    }
                </div>
            </div>

        </div>

        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-eye me-2 text-primary"></i>Preview</h6>
                </div>
                <div class="card-body p-0" style="min-height: 500px;">
                    <iframe src="" name="preview"
                            class="w-100 h-100 border-0 rounded-bottom"
                            style="min-height: 500px;">
                        Select a document to preview
                    </iframe>
                </div>
            </div>
        </div>

    </div>
</div>
