@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "layout.cshtml";
	ViewData["Title"] = "Access Denied";
}

<div class="container">
	<div class="row justify-content-center">
		<div class="col-12 col-md-6 col-lg-5 text-center py-5">
			<i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
			<h2 class="fw-semibold mt-3">Access Denied</h2>
			<p class="text-muted">You do not have permission to view this resource.</p>
			<hr />
			<a href="/login" class="btn btn-primary me-2">
				<i class="bi bi-box-arrow-in-right me-1"></i>Sign in as another user
			</a>
			<a href="/" class="btn btn-outline-secondary">
				<i class="bi bi-house me-1"></i>Go home
			</a>
		</div>
	</div>
</div>
