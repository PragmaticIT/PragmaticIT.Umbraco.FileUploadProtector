@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "layout.cshtml";
	ViewData["Title"] = "Select Document";
}

<div class="container">
	<div class="row justify-content-center">
		<div class="col-12 col-md-7 col-lg-6 text-center py-5">
			<i class="bi bi-file-earmark-arrow-up text-secondary" style="font-size: 3.5rem;"></i>
			<h4 class="fw-semibold mt-3">Select a document to preview</h4>
			<p class="text-muted small">Choose a document from the list on the left to display its contents here.</p>
		</div>
	</div>
</div>
